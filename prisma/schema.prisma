// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  ADMIN
  FLEET_MANAGER
  DISPATCHER
  SAFETY_OFFICER
  FINANCIAL_ANALYST
}

enum VehicleType {
  TRUCK
  VAN
  PICKUP
  TRAILER
  BUS
  SEDAN
}

enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  IN_SHOP
  RETIRED
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  OFF_DUTY
  SUSPENDED
}

enum TripStatus {
  DRAFT
  DISPATCHED
  COMPLETED
  CANCELLED
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

enum MaintenanceServiceType {
  OIL_CHANGE
  TIRE_REPLACEMENT
  BRAKE_SERVICE
  ENGINE_REPAIR
  TRANSMISSION
  ELECTRICAL
  BODY_WORK
  GENERAL_INSPECTION
  OTHER
}

enum LicenseCategory {
  A
  B
  C
  D
  E
  CE
  DE
}

enum ExpenseCategory {
  TOLL
  PARKING
  INSURANCE
  FINE
  REPAIR
  OTHER
}

// ─────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(DISPATCHER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  trips     Trip[]
  auditLogs AuditLog[]

  @@map("users")
}

model Vehicle {
  id              String        @id @default(cuid())
  regNo           String        @unique
  name            String
  type            VehicleType
  capacityKg      Decimal       @db.Decimal(10, 2)
  odometer        Decimal       @default(0) @db.Decimal(12, 2)
  acquisitionCost Decimal       @db.Decimal(12, 2)
  status          VehicleStatus @default(AVAILABLE)
  region          String        @default("Default")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  trips           Trip[]
  maintenanceLogs MaintenanceLog[]
  fuelLogs        FuelLog[]
  expenses        Expense[]

  @@index([status])
  @@index([type])
  @@index([region])
  @@map("vehicles")
}

model Driver {
  id              String          @id @default(cuid())
  name            String
  licenseNo       String          @unique
  licenseCategory LicenseCategory
  licenseExpiry   DateTime
  contactNo       String
  safetyScore     Decimal         @default(100) @db.Decimal(5, 2)
  status          DriverStatus    @default(AVAILABLE)
  region          String          @default("Default")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  trips Trip[]

  @@index([status])
  @@index([licenseExpiry])
  @@map("drivers")
}

model Trip {
  id                String     @id @default(cuid())
  code              String     @unique
  source            String
  destination       String
  vehicleId         String
  driverId          String
  createdById       String
  cargoWeightKg     Decimal    @db.Decimal(10, 2)
  plannedDistanceKm Decimal    @db.Decimal(10, 2)
  actualDistanceKm  Decimal?   @db.Decimal(10, 2)
  revenue           Decimal?   @db.Decimal(12, 2)
  status            TripStatus @default(DRAFT)
  dispatchedAt      DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  completionNotes   String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // Relations
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id])
  driver    Driver    @relation(fields: [driverId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])
  fuelLogs  FuelLog[]
  expenses  Expense[]

  @@index([status])
  @@index([vehicleId])
  @@index([driverId])
  @@index([createdAt])
  @@map("trips")
}

model MaintenanceLog {
  id            String                 @id @default(cuid())
  vehicleId     String
  serviceType   MaintenanceServiceType
  description   String?
  cost          Decimal                @db.Decimal(12, 2)
  status        MaintenanceStatus      @default(SCHEDULED)
  scheduledDate DateTime
  completedDate DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  // Relations
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@index([status])
  @@map("maintenance_logs")
}

model FuelLog {
  id             String   @id @default(cuid())
  vehicleId      String
  tripId         String?
  date           DateTime
  liters         Decimal  @db.Decimal(10, 2)
  costPerLiter   Decimal  @db.Decimal(8, 4)
  totalCost      Decimal  @db.Decimal(12, 2)
  odometerAtFill Decimal? @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  // Relations
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  trip    Trip?   @relation(fields: [tripId], references: [id])

  @@index([vehicleId])
  @@index([tripId])
  @@index([date])
  @@map("fuel_logs")
}

model Expense {
  id          String          @id @default(cuid())
  vehicleId   String?
  tripId      String?
  category    ExpenseCategory
  description String?
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime
  createdAt   DateTime        @default(now())

  // Relations
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])
  trip    Trip?    @relation(fields: [tripId], references: [id])

  @@index([vehicleId])
  @@index([tripId])
  @@index([category])
  @@index([date])
  @@map("expenses")
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String
  action       String
  entity       String
  entityId     String
  previousData Json?
  newData      Json?
  timestamp    DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@index([timestamp])
  @@map("audit_logs")
}
